# Agent resource links generated by script/setup-agent-links.sh / .ps1
#
# .agent/ and AGENTS.md are the source of truth and are committed. The paths
# below are local setup artifacts: symbolic links on Linux and macOS,
# directory junctions on Windows. A junction stores an absolute path, so these
# cannot be shared across machines and are regenerated by the setup script.
/.claude/skills
/.claude/rules
/.claude/agents
/.claude/commands
/.agents/skills
/.opencode/commands

# Project-scoped MCP configuration. Normally committed, but here it is a link
# to the committed source of truth at .agent/mcp/servers.json.
/.mcp.json

# Claude Code v2.1.277+ reads AGENTS.md directly; older versions need this
# link to it.
/CLAUDE.md

# Written by Claude Code itself; personal to each developer.
/.claude/settings.local.json
