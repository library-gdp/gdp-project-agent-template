# Agent resource links generated by script/setup-agent-links.sh / .ps1
#
# .agent/ is the source of truth and is committed. The paths below are local
# setup artifacts: symbolic links on Linux and macOS, directory junctions on
# Windows. A junction stores an absolute path, so these cannot be shared
# across machines and are regenerated by running the setup script.
/.claude/skills
/.claude/rules
/.claude/agents
/.claude/commands
/.opencode/skill
/.opencode/command

# Project-scoped MCP configuration. Normally committed, but here it is a link
# to the committed source of truth at .agent/mcp/servers.json.
/.mcp.json

# Written by Claude Code itself; personal to each developer.
/.claude/settings.local.json
